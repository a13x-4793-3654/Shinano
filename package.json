{
  "name": "shinano-browser",
  "productName": "Shinano",
  "version": "0.1.0",
  "private": true,
  "description": "A single-window, multi-profile Chromium browser for Microsoft 365 demos",
  "type": "module",
  "main": "dist/main/main.cjs",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "electron": "44.2.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
